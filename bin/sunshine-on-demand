#!/usr/bin/env bash
# sunshine-on-demand start|stop|status|cleanup|login|healthcheck|learn-client
#
# Start/stop the Sunshine user service by hand (menu entries, KDE Connect, ...).
# When started this way it still stops itself after IDLE_LIMIT without a stream.
#
# "stop" also runs "cleanup": if a stream app was still running (Moonlight
# disconnected without quitting the app), Sunshine never ran the app's undo
# steps - so restore the display, re-lock the session if the stream unlocked it,
# reset Steam and release the sleep inhibitor here.
#
# "login" (sunshine-login.service, at graphical login): if Moonlight sent a Wake
# while nobody was logged in (the PC booted to the login screen), the Wake
# listener left /run/sunshine-on-demand/wake-pending - start Sunshine now so
# Moonlight can connect as soon as you've logged in.
#
# "healthcheck" (sunshine-healthcheck.service, pulled in by every Sunshine start,
# and by a Wake while Sunshine already runs): Sunshine stays "active" even when
# it found no display/encoder at startup - e.g. right after resume from sleep,
# before the GPU's outputs are back - and then no client can connect. If this
# start logged "Fatal: Unable to find display or encoder", restart it.
#
# "learn-client" (first "do" step of the streamed app): Sunshine runs it while
# the client's HTTPS launch request - which only a PAIRED client (certificate)
# can make - is still open. Record that client's MAC address(es) in
# /var/lib/sunshine-on-demand/clients, so the TV-session check at boot can
# recognise the TV on any IP, on cable or Wi-Fi. Never fails (a failing "do"
# step would abort the stream).

set -u
CONFIG=${SOD_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/sunshine-on-demand/config.env}
# shellcheck source=/dev/null
[[ -r $CONFIG ]] && . "$CONFIG"
UNIT=${SUNSHINE_UNIT:-app-dev.lizardbyte.app.Sunshine.service}
BIN=$(dirname "$(readlink -f "$0")")
RUN=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
log() { echo "sunshine-on-demand: $*"; logger -t sunshine-on-demand -- "$*" 2>/dev/null || true; }

cleanup() {
  local left=no
  [[ -e $RUN/sunshine-display-mode.prev || -e $RUN/sunshine-unlocked-session ]] && left=yes
  systemctl --user is-active --quiet sunshine-stream-inhibit.service && left=yes
  [[ $left == yes ]] || return 0
  log "a stream app was still active; undoing its changes"
  [[ -e $RUN/sunshine-display-mode.prev ]] && "$BIN/sunshine-display-mode" restore
  if [[ ${APP_OPEN_CMD:-} == *bigpicture* ]]; then "$BIN/sunshine-steam-reset"; fi
  "$BIN/sunshine-session-lock" relock
  systemctl --user stop sunshine-stream-inhibit.service 2>/dev/null || true
}

login() {
  local flag=/run/sunshine-on-demand/wake-pending age
  [[ -e $flag ]] || return 0
  age=$(( $(date +%s) - $(stat -c %Y "$flag") ))
  rm -f "$flag" 2>/dev/null || true
  if (( age <= ${WAKE_PENDING_MAX_AGE:-900} )); then
    log "Wake arrived ${age}s ago before login; starting Sunshine"
    systemctl --user start "$UNIT"
  fi
}

healthcheck() {
  local attempt state id out verdict
  for (( attempt = 0; ; attempt++ )); do
    for _ in $(seq 1 30); do                 # wait while it is starting (ExecStartPre)
      state=$(systemctl --user is-active "$UNIT" 2>/dev/null)
      [[ $state == activating || $state == reloading ]] || break
      sleep 1
    done
    [[ $state == active ]] || return 0      # stopped or failed: systemd handles that
    id=$(systemctl --user show -p InvocationID --value "$UNIT")
    [[ -n $id ]] || return 0
    verdict=
    for _ in $(seq 1 30); do                 # wait for the end of Sunshine's startup
      out=$(journalctl --user _SYSTEMD_INVOCATION_ID="$id" -o cat --no-pager 2>/dev/null)
      if grep -q 'Fatal: Unable to find display or encoder' <<< "$out"; then verdict=broken; break; fi
      if grep -q 'Configuration UI available' <<< "$out"; then verdict=ok; break; fi
      systemctl --user is-active --quiet "$UNIT" || return 0
      sleep 1
    done
    [[ $verdict == broken ]] || return 0
    if (( attempt >= ${SUNSHINE_START_RETRIES:-3} )); then
      log "Sunshine still finds no display or encoder after $attempt restarts; giving up (check: journalctl --user -u $UNIT)"
      return 1
    fi
    log "Sunshine started without a display or encoder (e.g. GPU outputs not back yet after resume); restarting it"
    sleep 3
    systemctl --user restart --no-block "$UNIT"
    sleep 1
  done
}

learn_client() {
  local dir=${SOD_STATE_DIR:-/var/lib/sunshine-on-demand} ip mac now tmp
  [[ -d $dir && -w $dir ]] || { log "learn-client: $dir missing or not writable (run setup.sh install --system)"; return 0; }
  now=$(date +%s)
  for ip in $(ss -Htn state established '( sport = :47984 )' 2>/dev/null | awk '{print $4}' \
              | sed -E 's/^\[?(::ffff:)?//; s/\]?:[0-9]+$//' | sort -u); do
    ip route get "$ip" 2>/dev/null | grep -q ' via ' && continue      # routed: we'd only see the router's MAC
    mac=$(ip neigh show "$ip" 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "lladdr") {print $(i+1); exit}}')
    [[ $mac =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] || continue
    tmp=$(mktemp "$dir/.clients.XXXXXX") || return 0
    { grep -v "^$mac " "$dir/clients" 2>/dev/null; echo "$mac $ip $now"; } | tail -n 8 > "$tmp"
    chmod 644 "$tmp"; mv -f "$tmp" "$dir/clients"
    log "learn-client: paired client on $ip ($mac) remembered"
  done
  return 0
}

case "${1:-status}" in
  start)   systemctl --user start "$UNIT" ;;
  stop)    systemctl --user stop "$UNIT"; cleanup ;;
  cleanup) cleanup ;;
  login)   login ;;
  healthcheck) healthcheck ;;
  learn-client) learn_client ;;
  status)  systemctl --user --no-pager status "$UNIT" ;;
  *) echo "usage: $0 start|stop|status|cleanup|login|healthcheck|learn-client" >&2; exit 2 ;;
esac
