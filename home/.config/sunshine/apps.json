{
  "env": {},
  "apps": [
    {
      "name": "Steam Big Picture",
      "image-path": "steam.png",
      "prep-cmd": [
        {
          "do": "kscreen-doctor output.HDMI-A-2.mode.3840x2160@60",
          "undo": "kscreen-doctor output.HDMI-A-2.mode.1920x1080@165"
        },
        {
          "do": "",
          "undo": "setsid steam steam://close/bigpicture"
        }
      ],
      "detached": [
        "setsid steam steam://open/bigpicture"
      ]
    }
  ]
}
