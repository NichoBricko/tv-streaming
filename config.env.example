# sunshine-on-demand configuration
#
# Generate your own with:   ./setup.sh configure --client-ip <TV or streaming box IP>
# That auto-detects everything it can and writes config.env (not committed to git).
# Review it, then run:       ./setup.sh install
#
# Values are plain shell assignments (quote anything with spaces).

# ---------------------------------------------------------------- Sunshine
# User service that runs Sunshine. Detected automatically:
#   app-dev.lizardbyte.app.Sunshine.service  (Flatpak, newer distro packages)
#   sunshine.service                          (deb, AUR, older packages)
SUNSHINE_UNIT="app-dev.lizardbyte.app.Sunshine.service"
# Sunshine installed as a Flatpak? Then its prep commands are run on the host via
# "flatpak-spawn --host" (detected)
SUNSHINE_FLATPAK="no"

# Only start Sunshine on demand (Wake from Moonlight, menu entry) instead of at login
ON_DEMAND="yes"

# Stop Sunshine after this many seconds without a connected stream (0 = never)
IDLE_LIMIT=600
# Sunshine keeps running even when it found no display or encoder at startup
# (seen right after resume from sleep, before the GPU's outputs are back).
# sunshine-healthcheck.service then restarts it, up to this many times.
SUNSHINE_START_RETRIES=3

# ---------------------------------------------------------------- The streaming client
# IP of the device running Moonlight (TV, Apple TV, Shield, ...). Give it a fixed
# IP / DHCP reservation in your router - the firewall rules and the Wake listener
# only accept this address.
CLIENT_IP=""

# ---------------------------------------------------------------- Security
# Block keyboard/mouse input coming from the client (the TV remote can't type or
# move the mouse on your PC). Recommended.
BLOCK_CLIENT_KEYBOARD_MOUSE="yes"
# Also block controller input from the client. Use "yes" when the controller is
# paired to the PC itself (lowest latency); "no" when it's paired to the TV/box.
BLOCK_CLIENT_CONTROLLER="no"
# Require the video/audio stream to be encrypted on the LAN
REQUIRE_ENCRYPTION="yes"
# Sunshine web UI only reachable from this PC (https://localhost:47990)
WEB_UI_LOCAL_ONLY="yes"
# Offer only the app below to clients - removes Sunshine's built-in "Desktop" app
REMOVE_DESKTOP_APP="yes"
# Firewall to configure: ufw | firewalld | none   (detected)
FIREWALL="ufw"

# ---------------------------------------------------------------- The app clients can start
APP_NAME="Steam Big Picture"
# Command that opens the app (detached). Flatpak Steam:
#   "flatpak run com.valvesoftware.Steam steam://open/bigpicture"
APP_OPEN_CMD="steam steam://open/bigpicture"
# Steam client command used to close Big Picture / restart Steam afterwards
STEAM_CMD="steam"
# Restart Steam (minimized) after a stream so its window re-lays out for your
# monitor. Skipped automatically while a game is still running.
STEAM_RESET="yes"

# ---------------------------------------------------------------- Display switching
# Switch the PC's display to the client's resolution while streaming.
# Backend: kscreen (KDE) | xrandr (X11) | wlr-randr (Sway, Hyprland, other wlroots)
#          | custom (your own commands below, e.g. for GNOME) | none
DISPLAY_BACKEND="kscreen"
DISPLAY_OUTPUT="HDMI-A-1"
# "client" = use the resolution/fps Moonlight asks for; or a fixed mode like 3840x2160@60
STREAM_MODE="client"
# Used if STREAM_MODE=client fails (the output doesn't support the requested mode)
STREAM_MODE_FALLBACK="3840x2160@60"
# Mode to go back to if the previous mode couldn't be read (detected: your current mode)
RESTORE_MODE="1920x1080@60"
# Only for DISPLAY_BACKEND=custom. {W} {H} {R} are replaced with width/height/refresh.
# GNOME example (Mutter 48+ ships gdctl - check `gdctl set --help` for your version):
#   DISPLAY_SET_CMD="gdctl set --logical-monitor --primary --monitor DP-1 --mode {W}x{H}@{R}"
DISPLAY_SET_CMD=""
DISPLAY_RESTORE_CMD=""

# ---------------------------------------------------------------- Lock screen
# When a stream starts and the desktop is locked (e.g. Moonlight woke the PC from
# sleep), unlock it; lock again when the stream ends - but only if the stream
# unlocked it. Works with loginctl-aware lockers (KDE, GNOME).
UNLOCK_FOR_STREAM="yes"

# Keep the PC from sleeping / blanking while a stream runs
INHIBIT_SLEEP="yes"

# ---------------------------------------------------------------- Wake-on-LAN
# Start Sunshine when Moonlight's "Wake PC" packet arrives (PC awake), and after
# resume from sleep (PC woken by the packet). Needs WoL enabled in BIOS/UEFI.
WAKE_ON_LAN="yes"
WOL_IFACE="eth0"
WOL_MAC="00:00:00:00:00:00"
# NetworkManager connection to enable "wake-on-lan magic" on ("" = skip; set WoL
# yourself, e.g. systemd-networkd WakeOnLan=magic or ethtool -s eth0 wol g)
NM_CONNECTION="Wired connection 1"

# ---------------------------------------------------------------- TV session (cold boot)
# Waking the PC from power-off normally ends at the login screen, where Sunshine
# can't run. With TV_SESSION=yes the display manager auto-logs you into a minimal
# "Steam TV" session: KWin started LOCKED, running only Steam Big Picture and
# Sunshine (no desktop, no autostart apps). A paired stream unlocks it like after
# sleep. Your normal desktop login still needs your password.
# Supported display managers: Plasma Login Manager, SDDM. KDE's KWin required.
TV_SESSION="no"
# When to auto-login into it:
#   auto    (recommended) all three triggers below
#           + client check: right after boot, alongside the login screen, the PC
#           pings CLIENT_IP; if the TV/box answers (it's on - you pressed Wake in
#           Moonlight), it logs into the TV session. TV off -> normal login screen.
#           Booting by hand while the TV is on also lands in the (locked) TV session;
#           unlock it at the PC to get the normal login screen.
#   on-wake a Moonlight Wake arrives while the PC sits at the login screen (after a
#           Wake from power-off: press Wake once to power on, again once it booted)
#           -> one-time auto-login, the login screen restarts into the TV session
#   wol     at boot, if the BIOS reports Wake-on-LAN as the boot reason (SMBIOS
#           Wake-up Type - many boards always report "Power Switch")
#   always  every boot  |  no
TV_AUTOLOGIN="auto"
# SMBIOS wake-up types that count as Wake-on-LAN (check yours after a Moonlight
# wake: sudo dmidecode -t 1 | grep -i wake)
TV_WAKE_TYPES="LAN Remote,PCI PME#"
# How long after boot the client check keeps pinging CLIENT_IP
TV_CLIENT_CHECK_SECONDS=60
# What to do when the TV session has been idle for IDLE_LIMIT: suspend | none
TV_SESSION_IDLE_ACTION="suspend"

# ---------------------------------------------------------------- Stream smoothness
# Most smart TVs have a 100 Mb/s network port. Keyframes (scene changes) are sent
# as a line-rate burst that overflows the TV or the switch -> broken frames, stutter.
# Limit keyframe size (AMD/Intel VAAPI; ignored by other encoders): yes | no
# Verified on the reference setup: together with Moonlight's NDL decoder it took an
# LG TV from 170 dropped packets/min to 0, at 40 and at 60 Mbps.
# Slightly softer picture right after a scene cut.
SUNSHINE_STRICT_RC="yes"
# Pace only Sunshine's video stream (UDP 47998) to this many Mbit/s ("" = off).
# 90 for TVs with 100 Mb/s Ethernet. Other traffic is not shaped.
STREAM_PACING_MBIT=""
# Interface to pace (default: WOL_IFACE)
STREAM_IFACE=""

# ---------------------------------------------------------------- Encoder (optional)
# Leave empty to let Sunshine choose. Examples: vaapi (AMD/Intel), nvenc (NVIDIA)
SUNSHINE_ENCODER=""
# kms (fastest, needs setcap below) | portal | wlr | x11 | "" (auto)
SUNSHINE_CAPTURE=""
# Render node of the GPU to encode on, e.g. /dev/dri/renderD128 ("" = auto)
SUNSHINE_ADAPTER=""
# Sunshine log level: "" (default, info) | debug | verbose. "debug" records every
# request a Moonlight client makes (status polls, pairing, launch, resume, quit) -
# useful for troubleshooting, noisy otherwise. Read with:
#   journalctl --user -u <SUNSHINE_UNIT> -f
SUNSHINE_LOG_LEVEL=""
# Give a natively installed Sunshine cap_sys_admin (KMS capture) + cap_sys_nice
# (high encoder priority). Must be re-run after Sunshine updates: ./setup.sh setcap
SETCAP="no"
