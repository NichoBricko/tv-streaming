#!/bin/sh
# Wayland session entry point: KWin, started LOCKED, running only
# sunshine-tv-session-inner (Steam Big Picture + Sunshine). The session ends
# when the inner script exits. See README "TV session".
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=sunshine-tv
exec /usr/bin/kwin_wayland --xwayland --lockscreen \
  --exit-with-session=/usr/local/lib/sunshine-on-demand/sunshine-tv-session-inner
