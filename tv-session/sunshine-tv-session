#!/bin/sh
# Wayland session entry point: KWin running only sunshine-tv-session-inner,
# which locks the session through logind before starting anything, then runs
# Steam Big Picture + Sunshine. The session ends when the inner script exits.
# (Not "kwin_wayland --lockscreen": that lock isn't reported to logind
# (LockedHint stays "no"), so a stream couldn't unlock it.)
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=sunshine-tv
exec /usr/bin/kwin_wayland --xwayland \
  --exit-with-session=/usr/local/lib/sunshine-on-demand/sunshine-tv-session-inner
