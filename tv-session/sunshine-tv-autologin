#!/usr/bin/python3 -I
"""Auto-login into the TV session ("sunshine-tv": locked kiosk with Steam Big
Picture + Sunshine) when the PC was woken for streaming. Runs as root.

  sunshine-tv-autologin boot   (sunshine-tv-autologin.service, before the
                                display manager) - reads the SMBIOS "Wake-up
                                Type" of this boot (type 1, offset 0x18). Many
                                boards report "Power Switch" for every boot, so
                                this alone is often not enough.
  sunshine-tv-autologin wake   (sunshine-tv-wake.path/.service) - the Wake
                                listener received a magic packet from the client
                                while nobody was logged in (the PC sits at the
                                login screen after a Wake from power-off): enable
                                a ONE-TIME auto-login into the TV session, restart
                                the login screen, then remove the auto-login again.

Settings (/etc/sunshine-on-demand.env):
  TV_AUTOLOGIN   auto (default: boot check + wake trigger) | wol (boot check only)
                 | on-wake (wake trigger only) | always (every boot) | no
  TV_WAKE_TYPES  comma-separated wake types that count as Wake-on-LAN
                 (default "LAN Remote,PCI PME#")
  SOD_USER       user to log in

Only autologin entries this script created (Session=sunshine-tv) are ever
removed, so an autologin you configured yourself is left alone.
"""
import json
import os
import re
import subprocess
import sys
import time

SESSION = "sunshine-tv"
WAKE_TYPES = {0: "Reserved", 1: "Other", 2: "Unknown", 3: "APM Timer", 4: "Modem Ring",
              5: "LAN Remote", 6: "Power Switch", 7: "PCI PME#", 8: "AC Power Restored"}
PLASMALOGIN_CONF = "/etc/plasmalogin.conf"
SDDM_DROPIN = "/etc/sddm.conf.d/zz-sunshine-tv-autologin.conf"


def log(msg):
    print(f"sunshine-tv-autologin: {msg}", flush=True)


def wake_type():
    try:
        raw = open("/sys/firmware/dmi/entries/1-0/raw", "rb").read()
    except OSError as e:
        return f"unreadable ({e.strerror})"
    if len(raw) <= 0x18 or raw[1] <= 0x18:
        return "not reported"
    return WAKE_TYPES.get(raw[0x18], f"0x{raw[0x18]:02x}")


def display_manager():
    try:
        target = os.path.basename(os.path.realpath("/etc/systemd/system/display-manager.service"))
    except OSError:
        return ""
    return target.removesuffix(".service")


def set_plasmalogin(user):
    """Set or clear [Autologin] User/Session in plasmalogin.conf (line-based, keeps the rest)."""
    try:
        lines = open(PLASMALOGIN_CONF).read().splitlines()
    except FileNotFoundError:
        lines = []
    # locate the [Autologin] section
    start = next((i for i, l in enumerate(lines) if l.strip() == "[Autologin]"), None)
    if start is None:
        if not user:
            return False
        lines += ["", "[Autologin]"]
        start = len(lines) - 1
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("[")), len(lines))
    section = lines[start + 1:end]
    keys = {m.group(1): i for i, l in enumerate(section) if (m := re.match(r"\s*(\w+)\s*=", l))}
    ours = any(re.fullmatch(rf"\s*Session\s*=\s*{SESSION}(\.desktop)?\s*", l) for l in section)
    if user:
        new = {"User": user, "Session": SESSION}
        for k, v in new.items():
            if k in keys:
                section[keys[k]] = f"{k}={v}"
            else:
                section.append(f"{k}={v}")
    else:
        if not ours:
            return False          # not our autologin - leave it
        section = [l for l in section if not re.match(r"\s*User\s*=", l)]
        section = [f"Session=plasma" if re.match(r"\s*Session\s*=", l) else l for l in section]
    lines[start + 1:end] = section
    open(PLASMALOGIN_CONF, "w").write("\n".join(lines) + "\n")
    return True


def set_sddm(user):
    if user:
        os.makedirs(os.path.dirname(SDDM_DROPIN), exist_ok=True)
        open(SDDM_DROPIN, "w").write(f"# written by sunshine-tv-autologin at boot\n"
                                     f"[Autologin]\nUser={user}\nSession={SESSION}\n")
        return True
    if os.path.exists(SDDM_DROPIN):
        os.remove(SDDM_DROPIN)
        return True
    return False


def apply(dm, user):
    if dm == "plasmalogin":
        return set_plasmalogin(user)
    if dm == "sddm":
        return set_sddm(user)
    log(f"display manager '{dm}' not supported for automatic TV login; skipping")
    return None


def user_logged_in(user):
    """True if `user` has a real (class=user) login session."""
    out = subprocess.run(["loginctl", "list-sessions", "--json=short"], capture_output=True, text=True).stdout
    try:
        sessions = json.loads(out or "[]")
    except json.JSONDecodeError:
        return True                    # unknown -> don't disturb anything
    return any(s.get("user") == user and s.get("class") == "user" for s in sessions)


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "boot"
    mode = os.environ.get("TV_AUTOLOGIN", "auto")
    user = os.environ.get("SOD_USER", "")
    dm = display_manager()

    if action == "wake":
        if mode not in ("auto", "on-wake") or not user:
            return 0
        if user_logged_in(user):
            log(f"wake: {user} is already logged in; nothing to do")
            return 0
        log(f"wake: nobody logged in - one-time auto-login of {user} into the TV session")
        if apply(dm, user) is None:
            return 0
        subprocess.run(["systemctl", "restart", "display-manager.service"], check=False)
        time.sleep(20)                 # the login manager reads its config while starting
        apply(dm, "")
        log("wake: one-time auto-login removed again")
        return 0

    allowed = {t.strip() for t in os.environ.get("TV_WAKE_TYPES", "LAN Remote,PCI PME#").split(",")}
    wt = wake_type()
    enable = bool(user) and (mode == "always" or (mode in ("auto", "wol") and wt in allowed))
    log(f"wake-up type: {wt}; mode: {mode}; display manager: {dm or '?'} -> "
        f"{'auto-login into the TV session' if enable else 'normal login screen'}")
    if apply(dm, user if enable else ""):
        log("display manager config updated")
    return 0


if __name__ == "__main__":
    sys.exit(main())
