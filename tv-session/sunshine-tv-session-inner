#!/usr/bin/env bash
# Runs inside the locked KWin of the TV session (started by sunshine-tv-session).
#
#  - publishes the session's display to user services (Sunshine, kscreen, portals)
#  - starts Sunshine
#  - waits until a stream asks for the app (sunshine-open-app creates
#    $XDG_RUNTIME_DIR/sunshine-tv-open), then runs Steam Big Picture as the only
#    application; the session ends when Steam exits ("Exit Steam")
#  - if someone unlocks the session at the PC itself while it waits (not via a
#    stream), the session ends, so they land at the normal login screen
#
# Nothing else is started: no Plasma shell, no XDG autostart, no
# graphical-session.target user services. The session stays locked until a
# paired Moonlight client starts a stream (sunshine-session-lock).

set -u
CONFIG=${SOD_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/sunshine-on-demand/config.env}
# shellcheck source=/dev/null
[[ -r $CONFIG ]] && . "$CONFIG"
UNIT=${SUNSHINE_UNIT:-app-dev.lizardbyte.app.Sunshine.service}
read -r -a STEAM <<< "${STEAM_CMD:-steam}"
RUN=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
MARKER=$RUN/sunshine-tv-session
VARS=(WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_ID)
log() { echo "sunshine-tv-session: $*"; logger -t sunshine-tv-session -- "$*" 2>/dev/null || true; }

# Lock FIRST, through logind (so LockedHint is set and a stream can unlock it
# with "loginctl unlock-session"). Nothing is running yet that could be used.
for _ in $(seq 1 50); do
  loginctl lock-session "${XDG_SESSION_ID:-}" 2>/dev/null
  [[ $(loginctl show-session "${XDG_SESSION_ID:-}" -p LockedHint --value 2>/dev/null) == yes ]] && break
  sleep 0.2
done
if [[ $(loginctl show-session "${XDG_SESSION_ID:-}" -p LockedHint --value 2>/dev/null) != yes ]]; then
  log "could not lock the session - ending it for safety"
  exit 1
fi
log "session ${XDG_SESSION_ID:-?} locked"

echo "${XDG_SESSION_ID:-}" > "$MARKER"
rm -f /run/sunshine-on-demand/wake-pending 2>/dev/null || true   # this wake is handled
dbus-update-activation-environment --systemd "${VARS[@]}" 2>/dev/null \
  || systemctl --user import-environment "${VARS[@]}"
log "TV session started (session ${XDG_SESSION_ID:-?}); starting Sunshine, Steam waits for a stream"
rm -f "$RUN/sunshine-tv-open"
systemctl --user start "$UNIT"

# Wait for a stream to ask for the app - or for a local unlock at the PC
while [[ ! -e $RUN/sunshine-tv-open ]]; do
  if [[ $(loginctl show-session "${XDG_SESSION_ID:-}" -p LockedHint --value 2>/dev/null) == no \
        && ! -e $RUN/sunshine-unlocked-session ]]; then
    log "session unlocked at the PC (not by a stream); ending the TV session -> login screen"
    "$HOME/.local/bin/sunshine-on-demand" stop 2>/dev/null || systemctl --user stop "$UNIT"
    rm -f "$MARKER"
    exit 0
  fi
  sleep 1
done
rm -f "$RUN/sunshine-tv-open"
log "stream asked for Steam Big Picture; starting it"

"${STEAM[@]}" -gamepadui
# The launcher can return while the client keeps running (restart after an update)
while pgrep -x steam >/dev/null || pgrep -f 'com.valvesoftware.Steam' >/dev/null; do sleep 2; done

log "Steam exited; ending the TV session"
"$HOME/.local/bin/sunshine-on-demand" stop 2>/dev/null || systemctl --user stop "$UNIT"
rm -f "$MARKER"
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XAUTHORITY 2>/dev/null || true
